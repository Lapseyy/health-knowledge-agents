# Copy to .env and fill in real values. Never commit .env.

# --- Generation providers (at least two different providers required) ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-3.8-flash

# --- Embeddings (do not count toward the two-provider requirement) ---
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# --- RAG ---
CHROMA_PERSIST_DIR=./chroma_index
CHROMA_COLLECTION=ap2e
RETRIEVAL_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Live knowledge (Tavily Remote MCP) ---
TAVILY_API_KEY=tvly-...

# --- Cloud Run ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=health-knowledge-agents
