# Copy to .env and fill in real values. Never commit .env.

# --- Generation provider 1: NVIDIA NIM ---
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- Generation provider 2: Google Gemini ---
GEMINI_MODEL=gemini-3.8-flash
GEMINI_REASONING_EFFORT=low
# Option A (default): Vertex AI, authenticated with Google Cloud credentials
# instead of an API key. Locally: run `gcloud auth application-default login`.
# On Cloud Run: grant the service account the Vertex AI User role.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# Option B: a Gemini API key from Google AI Studio. Set
# GOOGLE_GENAI_USE_VERTEXAI=false and uncomment:
# GOOGLE_API_KEY=...

# --- Embeddings: local ONNX model, no API key (not a generation provider) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./models

# --- RAG ---
CHROMA_PERSIST_DIR=./chroma_index
CHROMA_COLLECTION=ap2e
RETRIEVAL_K=5
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# --- Live knowledge (Tavily Remote MCP) ---
TAVILY_API_KEY=tvly-...

# --- Startup ---
# One tiny call per model at startup so the first turn isn't slowed by connection
# setup. Set to false to measure a fully cold first turn.
WARM_UP=true

# --- Cloud Run ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-west1
CLOUD_RUN_SERVICE=health-knowledge-agents
